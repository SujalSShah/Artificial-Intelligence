<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <category>
        <pattern>HELLO</pattern>
        <template>
            Hello! How can I help you?
        </template>
    </category>

    <category>
        <pattern>HI</pattern>
        <template>
            Hi there! Nice to meet you.
        </template>
    </category>

    <category>
        <pattern>WHAT IS YOUR NAME</pattern>
        <template>
            My name is SimpleBot.
        </template>
    </category>

    <category>
        <pattern>HOW ARE YOU</pattern>
        <template>
            I am doing great! Thanks for asking.
        </template>
    </category>

    <category>
        <pattern>WHAT CAN YOU DO</pattern>
        <template>
            I can answer simple questions and have a basic conversation with you.
        </template>
    </category>

    <category>
        <pattern>BYE</pattern>
        <template>
            Goodbye! Have a nice day.
        </template>
    </category>

</aiml>
